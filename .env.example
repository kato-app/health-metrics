# Copy to .env and fill in. Never commit .env.

# GitHub fine-grained personal access token with access to the organisation in
# config.json and its repositories (used for both REST and GraphQL calls).
# Repository permissions needed: Metadata (read), Contents (read), Pull requests (read).
GITHUB_TOKEN=github_pat_xxx

# Path to the Google service account key JSON. The service account's email
# must be shared onto the target spreadsheet as an Editor.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# Jira Cloud site and an API token created at
# https://id.atlassian.com/manage-profile/security/api-tokens by the user
# below. The token inherits that user's permissions and expires (max 1 year).
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=service-user@example.com
ATLASSIAN_TOKEN=xxx
